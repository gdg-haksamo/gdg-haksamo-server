# 로컬 개발용 환경변수 예시
# 사용법: 이 파일을 `.env`로 복사 후 값을 채워 넣으세요.
# `.env`는 .gitignore 처리되어 있어 커밋되지 않습니다.

# === Spring ===
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# === DB (docker-compose의 db 서비스 기준) ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=haksamo
DB_USERNAME=haksamo
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme-root

# === JWT ===
# 운영용 비밀키는 충분히 길고 랜덤한 값으로 교체하세요 (최소 32바이트)
JWT_SECRET=please-replace-this-with-a-very-long-random-string-at-least-32-bytes
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# === 이메일 인증번호 SMTP (prod 전용) ===
# dev 프로파일은 LoggingMailSender(로그 출력)라 아래 값이 없어도 동작합니다.
# prod에선 spring.mail.host가 있어야 JavaMailSender가 구성되어 앱이 부팅됩니다.
# Gmail 사용 시: 2단계 인증 활성화 후 '앱 비밀번호'(16자리)를 MAIL_PASSWORD에 넣으세요.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# === 최초 SUPER_ADMIN(운영팀) 시더 ===
# 값을 채우면 앱 시작 시 해당 계정이 없을 때만 SUPER_ADMIN으로 1회 생성됩니다(멱등).
# 비워두면 시더는 스킵됩니다. 평문은 .env에만 두고, DB엔 BCrypt 해시로 저장됩니다.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=운영팀
